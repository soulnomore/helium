+
+void VerticalTabStripRegionView::ToggleTabFolders() {
+  browser_view()->GetProfile()->GetPrefs()->SetBoolean(
+      tabs::kShowTabFolders, !tab_folders_ || !tab_folders_->GetVisible());
+}
+
+void VerticalTabStripRegionView::CloseTabFolders(extensions::ExtensionHost*) {
+  browser_view()->GetProfile()->GetPrefs()->SetBoolean(tabs::kShowTabFolders,
+                                                       false);
+  content_area_view_->RemoveChildViewT(tab_folders_.ExtractAsDangling());
+  tab_folders_host_.reset();
+}
+
+void VerticalTabStripRegionView::UpdateTabFolders() {
+  if (!tab_folders_button_ || !tab_strip_view()) {
+    return;
+  }
+  Profile* profile = browser_view()->GetProfile();
+  auto* registry = extensions::ExtensionRegistry::Get(profile);
+  const auto* extension =
+      registry ? registry->GetExtensionById(
+                     extension_misc::kHeliumTabFoldersExtensionId,
+                     extensions::ExtensionRegistry::ENABLED)
+               : nullptr;
+  const bool expanded = state_controller_->GetCollapseState() ==
+                        tabs::VerticalTabStripCollapseState::kExpanded;
+  tab_folders_button_->SetVisible(expanded && extension);
+  const bool show = expanded && extension &&
+                    profile->GetPrefs()->GetBoolean(tabs::kShowTabFolders);
+  if (show && !tab_folders_) {
+    tab_folders_host_ =
+        extensions::ExtensionViewHostFactory::CreateSidePanelHost(
+            *extension, extension->GetResourceURL("panel.html"),
+            browser_view()->browser(),
+            /*tab_interface=*/nullptr);
+    tab_folders_host_->SetCloseHandler(base::BindOnce(
+        &VerticalTabStripRegionView::CloseTabFolders, base::Unretained(this)));
+    // The wrapper owns visibility. An ExtensionViewViews can show itself when
+    // its first load completes while the user is collapsing the strip.
+    tab_folders_ =
+        content_area_view_->AddChildViewAt(std::make_unique<views::View>(), 0);
+    tab_folders_->SetUseDefaultFillLayout(true);
+    tab_folders_->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kUnbounded));
+    tab_folders_
+        ->AddChildView(std::make_unique<ExtensionViewViews>(
+            profile, tab_folders_host_.get()))
+        ->Init();
+  }
+  if (tab_folders_) {
+    tab_folders_->SetVisible(show);
+  }
+  tab_strip_view()->SetVisible(!show);
+  tab_folders_button_->SetText(l10n_util::GetStringUTF16(
+      show ? IDS_HELIUM_TAB_FOLDERS_BACK : IDS_HELIUM_TAB_FOLDERS));
+  bottom_button_container_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kPreferred,
+                               show ? views::MaximumFlexSizeRule::kPreferred
+                                    : views::MaximumFlexSizeRule::kUnbounded));
 }
 
