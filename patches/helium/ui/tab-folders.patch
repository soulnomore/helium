+TabFolderController::TabFolderController(PinnedTabContainerView& host,
+                                         TabCollectionNode& node)
+    : host_(host),
+      node_(node),
+      browser_(*node.GetController()->GetBrowserView()->browser()),
+      model_(*browser_->GetProfile()->GetPrefs()) {
+  browser_->GetTabStripModel()->AddObserver(this);
+  registrar_.Init(browser_->GetProfile()->GetPrefs());
+  registrar_.Add(helium_pins::kTabFoldersPref,
+                 base::BindRepeating(&TabFolderController::Reload,
+                                     base::Unretained(this)));
+  Reload();
+}
+
+TabFolderController::~TabFolderController() {
+  registrar_.RemoveAll();
+  destroying_.Notify();
+  menu_runner_.reset();
+  if (insertion_line_)
+    host_->RemoveChildViewT(insertion_line_.ExtractAsDangling());
+  for (auto& [id, button] : buttons_) {
+    host_->RemoveChildViewT(button.ExtractAsDangling());
+  }
+}
+
+void TabFolderController::OnTabStripModelChanged(
+    TabStripModel*,
+    const TabStripModelChange&,
+    const TabStripSelectionChange& selection) {
+  if (HasFolders() && selection.active_tab_changed())
+    host_->InvalidateLayout();
+}
+
+void TabFolderController::Reload() {
+  model_ = TabFolderModel(*browser_->GetProfile()->GetPrefs());
+  for (auto it = buttons_.begin(); it != buttons_.end();) {
+    if (model_.IsFolder(it->first)) {
+      ++it;
+      continue;
+    }
+    host_->RemoveChildViewT(it->second.ExtractAsDangling());
+    it = buttons_.erase(it);
+  }
+  for (const auto& entry : model_.entries()) {
+    if (!entry.is_folder())
+      continue;
+    auto& button = buttons_[entry.id];
+    if (!button)
+      button = host_->AddChildView(
+          std::make_unique<TabFolderButton>(*this, entry.id));
+    button->Update(entry, compact_);
+  }
+  for (auto* child : node_->GetDirectChildren())
+    child->InvalidateLayout();
+  host_->InvalidateLayout();
+}
+
+void TabFolderController::SetCompact(bool compact) {
+  if (compact_ == compact)
+    return;
+  compact_ = compact;
+  for (const auto& entry : model_.entries()) {
+    if (entry.is_folder())
+      buttons_.at(entry.id)->Update(entry, compact_);
+  }
+}
+
+void TabFolderController::NewFolder(const std::string& parent) {
+  const auto id =
+      model_.Create(parent, l10n_util::GetStringUTF16(IDS_HELIUM_FOLDER_NEW));
+  if (auto it = buttons_.find(id); it != buttons_.end()) {
+    if (host_->GetWidget())
+      host_->GetWidget()->LayoutRootViewIfNecessary();
+    it->second->ScrollViewToVisible();
+    it->second->Edit();
+  }
+}
+
+std::string TabFolderController::FiledId(const views::View& child) const {
+  auto find = [&](const TabView* tab) -> std::string {
+    const auto id = PinId(tab);
+    const auto* entry = model_.Find(id);
+    return entry && !entry->parent.empty() ? id : std::string();
+  };
+  if (const auto* split = views::AsViewClass<SplitTabView>(&child)) {
+    if (const auto* node = split->collection_node()) {
+      for (auto* view : node->GetDirectChildren()) {
+        auto id = find(views::AsViewClass<TabView>(view));
+        if (!id.empty())
+          return id;
+      }
+    }
+    return {};
+  }
+  return find(views::AsViewClass<TabView>(&child));
+}
+
+bool TabFolderController::IsFiled(const views::View& child) const {
+  return HasFolders() && !FiledId(child).empty();
+}
+
+std::vector<TabFolderController::Row> TabFolderController::Rows() const {
+  if (!HasFolders())
+    return {};
+  std::map<std::string, views::View*> tabs;
+  for (auto* child : node_->GetDirectChildren()) {
+    auto id = FiledId(*child);
+    if (!id.empty())
+      tabs.emplace(std::move(id), child);
+  }
+  std::vector<Row> rows;
+  auto visit = [&](auto& self, const std::string& parent, int depth,
+                   bool visible) -> void {
+    for (const auto& entry : model_.entries()) {
+      if (entry.parent != parent)
+        continue;
+      if (entry.is_folder()) {
+        rows.push_back({buttons_.at(entry.id), depth, visible});
+        self(self, entry.id, depth + 1, visible && !entry.collapsed);
+      } else if (auto it = tabs.find(entry.id); it != tabs.end()) {
+        rows.push_back({it->second, depth, visible || IsActiveRow(it->second)});
+      }
+    }
+  };
+  visit(visit, {}, 0, true);
+  return rows;
+}
+
+std::string TabFolderController::NextSibling(const std::string& id) const {
+  const auto& entries = model_.entries();
+  auto it = std::ranges::find(entries, id, &TabFolderModel::Entry::id);
+  if (it == entries.end())
+    return {};
+  const auto& parent = it->parent;
+  const auto next = std::find_if(
+      std::next(it), entries.end(),
+      [&](const auto& candidate) { return candidate.parent == parent; });
+  return next == entries.end() ? std::string() : next->id;
+}
+
+void TabFolderController::Highlight(const std::string& id,
+                                    DropPosition position) {
+  if (id == highlight_ && position == highlight_position_)
+    return;
+  if (auto it = buttons_.find(highlight_); it != buttons_.end())
+    it->second->Mark(std::nullopt);
+  highlight_ = id;
+  highlight_position_ = position;
+  if (auto it = buttons_.find(id); it != buttons_.end())
+    it->second->Mark(position);
+}
+
+void TabFolderController::ShowInsertionLine(const gfx::Rect& bounds) {
+  if (!bounds.IsEmpty()) {
+    if (!insertion_line_) {
+      auto line = std::make_unique<views::View>();
+      line->SetProperty(views::kViewIgnoredByLayoutKey, true);
+      line->SetCanProcessEventsWithinSubtree(false);
+      line->GetViewAccessibility().SetIsIgnored(true);
+      line->SetBackground(
+          views::CreateRoundedRectBackground(ui::kColorSysPrimary, 1));
+      insertion_line_ = host_->AddChildView(std::move(line));
+    }
+    insertion_line_->SetBoundsRect(bounds);
+  }
+  if (insertion_line_)
+    insertion_line_->SetVisible(!bounds.IsEmpty());
+}
+
+void TabFolderController::DragFolder(const std::string& id,
+                                     const gfx::Point& point,
+                                     bool drop) {
+  for (const auto& [target, button] : buttons_) {
+    if (!Hit(*button, point) || model_.Contains(id, target))
+      continue;
+    const auto local = views::View::ConvertPointFromScreen(button, point);
+    const auto* entry = model_.Find(target);
+    const auto position =
+        local.y() < button->height() / 4        ? DropPosition::kBefore
+        : local.y() >= 3 * button->height() / 4 ? DropPosition::kAfter
+                                                : DropPosition::kInside;
+    if (drop) {
+      Highlight({});
+      if (position == DropPosition::kInside)
+        model_.Move({id}, target);
+      else
+        model_.Move(
+            {id}, entry->parent,
+            position == DropPosition::kBefore ? target : NextSibling(target));
+    } else {
+      Highlight(target, position);
+    }
+    return;
+  }
+  Highlight({});
+}
+
+std::optional<TabFolderController::Destination>
+TabFolderController::FindDestination(const gfx::Point& point) const {
+  if (!HasFolders())
+    return std::nullopt;
+  if (Hit(*host_, point)) {
+    for (const auto& [id, button] : buttons_) {
+      if (Hit(*button, point))
+        return Destination{id, {}};
+    }
+    for (auto* child : node_->GetDirectChildren()) {
+      if (!Hit(*child, point))
+        continue;
+      const auto id = FiledId(*child);
+      if (const auto* entry = model_.Find(id)) {
+        const auto local = views::View::ConvertPointFromScreen(child, point);
+        const bool after = local.y() >= child->height() / 2;
+        const int y = after ? child->bounds().bottom() : child->y() - 2;
+        return Destination{entry->parent, after ? NextSibling(id) : id, false,
+                           gfx::Rect(child->x(), y, child->width(), 2)};
+      }
+    }
+  }
+  // A drag from a folder to loose tabs unpins it. A drag to the ordinary pin
+  // grid keeps it pinned. Other tab drags stay with Chromium's drag target.
+  // The tab strip already hit-tested its entire draggable area, including
+  // the empty space below the final open tab (or below the last folder).
+  const auto local = views::View::ConvertPointFromScreen(&host_.get(), point);
+  const bool over_open_tabs = local.y() >= host_->GetVisibleBounds().bottom();
+  if ((over_open_tabs || Hit(*host_, point)) &&
+      std::ranges::any_of(node_->GetDirectChildren(), [&](auto* child) {
+        return IsFiled(*child) &&
+               node_->GetController()->GetDragHandler().IsViewDragging(*child);
+      })) {
+    return Destination{{}, {}, over_open_tabs};
+  }
+  return std::nullopt;
+}
+
+TabDragTarget* TabFolderController::TargetAt(const gfx::Point& point) {
+  auto target = FindDestination(point);
+  if (!target)
+    return nullptr;
+  destination_ = std::move(target);
+  return this;
+}
+
+TabDragContext* TabFolderController::OnTabDragUpdated(
+    DragController& controller,
+    const gfx::Point&) {
+  drag_group_ = controller.GetSessionData().group_header_drag_data_.has_value();
+  const bool valid = destination_ && !drag_group_;
+  ShowInsertionLine(valid ? destination_->insertion_line : gfx::Rect());
+  Highlight(valid && destination_->insertion_line.IsEmpty()
+                ? destination_->folder
+                : std::string());
+  return node_->GetController()->GetDragHandler().GetDragContext();
+}
+bool TabFolderController::CanDropTab() {
+  return destination_.has_value() && !drag_group_;
+}
+void TabFolderController::OnTabDragExited(const gfx::Point&) {
+  OnTabDragEnded();
+}
+void TabFolderController::OnTabDragEnded() {
+  ShowInsertionLine({});
+  Highlight({});
+  destination_.reset();
+}
+base::CallbackListSubscription TabFolderController::RegisterWillDestroyCallback(
+    base::OnceClosure callback) {
+  return destroying_.Add(std::move(callback));
+}
+void TabFolderController::HandleTabDrop(DragController& controller) {
+  if (!CanDropTab())
+    return;
+  std::vector<tabs::TabHandle> tabs;
+  for (const auto& item : controller.GetSessionData().tab_drag_data_) {
+    if (item.contents)
+      tabs.push_back(
+          tabs::TabInterface::GetFromContents(item.contents)->GetHandle());
+  }
+  // Reparenting tabs during drag teardown can destroy the drag context.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&FileTabs, browser_->GetWeakPtr(),
+                                std::move(tabs), destination_->folder,
+                                destination_->before, destination_->unpin));
+}
+
+void TabFolderController::ShowMenu(const std::string& id,
+                                   const gfx::Point& point,
+                                   ui::mojom::MenuSourceType source) {
+  menu_folder_ = id;
+  menu_runner_.reset();
+  menu_ = std::make_unique<ui::SimpleMenuModel>(this);
+  destinations_menu_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_->AddItemWithStringId(kNew, IDS_HELIUM_FOLDER_SUBFOLDER);
+  menu_->AddItemWithStringId(kRename, IDS_HELIUM_FOLDER_RENAME);
+  menu_->AddItemWithStringId(kFileActive, IDS_HELIUM_FOLDER_FILE_ACTIVE);
+  menu_destinations_.clear();
+  menu_destinations_.push_back({});
+  destinations_menu_->AddItemWithStringId(kDestination,
+                                          IDS_HELIUM_FOLDER_TOP_LEVEL);
+  for (const auto& e : model_.entries()) {
+    if (!e.is_folder() || model_.Contains(id, e.id))
+      continue;
+    std::u16string path = e.name;
+    for (auto* parent = model_.Find(e.parent); parent;
+         parent = model_.Find(parent->parent)) {
+      path = parent->name + u" / " + path;
+    }
+    destinations_menu_->AddItem(kDestination + menu_destinations_.size(), path);
+    menu_destinations_.push_back(e.id);
+  }
+  menu_->AddSubMenuWithStringId(kMove, IDS_HELIUM_FOLDER_MOVE,
+                                destinations_menu_.get());
+  menu_->AddItemWithStringId(kUnpack, IDS_HELIUM_FOLDER_UNPACK);
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_.get(), views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(host_->GetWidget(), nullptr,
+                          gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source);
+}
+
+void TabFolderController::ExecuteCommand(int command, int) {
+  if (!model_.IsFolder(menu_folder_))
+    return;
+  switch (command) {
+    case kNew:
+      NewFolder(menu_folder_);
+      break;
+    case kRename:
+      buttons_.at(menu_folder_)->Edit();
+      break;
+    case kFileActive: {
+      if (auto* tab = browser_->GetTabStripModel()->GetActiveTab()) {
+        FileTabs(browser_->GetWeakPtr(), {tab->GetHandle()}, menu_folder_, {},
+                 false);
+      }
+      break;
+    }
+    case kUnpack:
+      model_.Unpack(menu_folder_);
+      break;
+    default:
+      if (command >= kDestination &&
+          static_cast<size_t>(command - kDestination) <
+              menu_destinations_.size()) {
+        model_.Move({menu_folder_}, menu_destinations_[command - kDestination]);
+      }
+  }
+}
