+// Copyright 2026 The Helium Authors
+// Use, redistribution, and modification are permitted under the GPL-3.0
+// license.
+
+#ifndef CHROME_BROWSER_UI_TABS_TAB_FOLDER_MODEL_H_
+#define CHROME_BROWSER_UI_TABS_TAB_FOLDER_MODEL_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ref.h"
+
+class PrefService;
+
+namespace helium_pins {
+
+inline constexpr char kTabFoldersPref[] = "helium.tab_folders";
+
+// An ordered snapshot of the profile's folder tree. Leaf IDs reference Helium
+// pins. The pin service owns their URLs, session restoration and live tabs.
+class TabFolderModel {
+ public:
+  struct Entry {
+    std::string id;
+    std::string parent;
+    std::u16string name;
+    bool collapsed = false;
+    bool is_folder() const { return !name.empty(); }
+  };
+
+  explicit TabFolderModel(PrefService& prefs);
+  ~TabFolderModel();
+  const std::vector<Entry>& entries() const { return entries_; }
+  const Entry* Find(const std::string& id) const;
+  bool IsFolder(const std::string& id) const;
+  bool Contains(const std::string& folder, const std::string& id) const;
+  std::string Create(const std::string& parent, const std::u16string& name);
+  void Rename(const std::string& id, const std::u16string& name);
+  void Toggle(const std::string& id);
+  // Empty parent means the top level. Empty before means append.
+  void Move(const std::vector<std::string>& ids,
+            std::string parent,
+            std::string before = {},
+            bool reveal = true);
+  void Unpack(const std::string& id);
+  void ForgetPin(const std::string& id);
+
+ private:
+  void Save();
+  raw_ref<PrefService> prefs_;
+  std::vector<Entry> entries_;
+};
+
+}  // namespace helium_pins
+
+#endif  // CHROME_BROWSER_UI_TABS_TAB_FOLDER_MODEL_H_
