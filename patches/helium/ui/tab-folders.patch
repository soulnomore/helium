+// Copyright 2026 The Helium Authors
+// Use, redistribution, and modification are permitted under the GPL-3.0
+// license.
+
+#include "chrome/browser/ui/tabs/tab_folder_model.h"
+
+#include <algorithm>
+#include <set>
+#include <utility>
+
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "components/prefs/pref_service.h"
+
+namespace helium_pins {
+
+TabFolderModel::TabFolderModel(PrefService& prefs) : prefs_(prefs) {
+  std::set<std::string> ids;
+  for (const auto& value : prefs.GetList(kTabFoldersPref)) {
+    const auto* dict = value.GetIfDict();
+    if (!dict)
+      continue;
+    const auto* id = dict->FindString("id");
+    const auto* parent = dict->FindString("parent");
+    if (!id || id->empty() || !parent || !ids.insert(*id).second)
+      continue;
+    const auto* name = dict->FindString("name");
+    entries_.push_back({*id, *parent,
+                        name ? base::UTF8ToUTF16(*name) : std::u16string(),
+                        dict->FindBool("collapsed").value_or(false)});
+  }
+  // A malformed parent link must never hide tabs or create a recursive tree.
+  for (auto& entry : entries_) {
+    if (!entry.parent.empty() &&
+        (!IsFolder(entry.parent) || Contains(entry.id, entry.parent))) {
+      entry.parent.clear();
+    }
+  }
+}
+
+TabFolderModel::~TabFolderModel() = default;
+
+const TabFolderModel::Entry* TabFolderModel::Find(const std::string& id) const {
+  const auto it = std::ranges::find(entries_, id, &Entry::id);
+  return it == entries_.end() ? nullptr : &*it;
+}
+
+bool TabFolderModel::IsFolder(const std::string& id) const {
+  const auto* entry = Find(id);
+  return entry && entry->is_folder();
+}
+
+bool TabFolderModel::Contains(const std::string& folder,
+                              const std::string& id) const {
+  size_t remaining = entries_.size();
+  for (auto* entry = Find(id); entry && remaining--;
+       entry = Find(entry->parent)) {
+    if (entry->id == folder)
+      return true;
+  }
+  return false;
+}
+
+std::string TabFolderModel::Create(const std::string& parent,
+                                   const std::u16string& name) {
+  if ((!parent.empty() && !IsFolder(parent)) || name.empty())
+    return {};
+  const std::string id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  entries_.push_back({id, parent, name});
+  for (auto& item : entries_) {
+    if (Contains(item.id, parent))
+      item.collapsed = false;
+  }
+  Save();
+  return id;
+}
+
+void TabFolderModel::Rename(const std::string& id, const std::u16string& name) {
+  std::u16string trimmed;
+  base::TrimWhitespace(name, base::TRIM_ALL, &trimmed);
+  auto it = std::ranges::find(entries_, id, &Entry::id);
+  if (it == entries_.end() || !it->is_folder() || trimmed.empty())
+    return;
+  it->name = std::move(trimmed);
+  Save();
+}
+
+void TabFolderModel::Toggle(const std::string& id) {
+  auto it = std::ranges::find(entries_, id, &Entry::id);
+  if (it == entries_.end() || !it->is_folder())
+    return;
+  it->collapsed = !it->collapsed;
+  Save();
+}
+
+void TabFolderModel::Move(const std::vector<std::string>& ids,
+                          std::string parent,
+                          std::string before,
+                          bool reveal) {
+  if (!parent.empty() && !IsFolder(parent))
+    return;
+  const auto* next = Find(before);
+  if (!before.empty() && (!next || next->parent != parent))
+    return;
+  std::vector<Entry> moved;
+  std::set<std::string> seen;
+  for (const auto& id : ids) {
+    if (id.empty() || id == before || Contains(id, parent))
+      return;
+    if (!seen.insert(id).second)
+      continue;
+    const auto* entry = Find(id);
+    if (!entry && parent.empty())
+      continue;
+    moved.push_back(entry ? *entry : Entry{id, {}, {}});
+    moved.back().parent = parent;
+  }
+  if (moved.empty())
+    return;
+  std::erase_if(entries_, [&](const Entry& e) { return seen.contains(e.id); });
+  // Top-level pins already get their order from the native pin list.
+  std::erase_if(
+      moved, [](const Entry& e) { return !e.is_folder() && e.parent.empty(); });
+  entries_.insert(std::ranges::find(entries_, before, &Entry::id),
+                  moved.begin(), moved.end());
+  if (reveal) {
+    for (auto& item : entries_) {
+      if (Contains(item.id, parent))
+        item.collapsed = false;
+    }
+  }
+  Save();
+}
+
+void TabFolderModel::Unpack(const std::string& id) {
+  const auto* folder = Find(id);
+  if (!folder || !folder->is_folder())
+    return;
+  const std::string parent = folder->parent;
+  std::vector<Entry> children;
+  for (const auto& item : entries_) {
+    if (item.parent == id && (item.is_folder() || !parent.empty())) {
+      children.push_back(item);
+      children.back().parent = parent;
+    }
+  }
+  std::erase_if(entries_, [&](const Entry& e) { return e.parent == id; });
+  auto pos = entries_.erase(std::ranges::find(entries_, id, &Entry::id));
+  entries_.insert(pos, children.begin(), children.end());
+  Save();
+}
+
+void TabFolderModel::ForgetPin(const std::string& id) {
+  if (std::erase_if(entries_, [&](const Entry& e) {
+        return !e.is_folder() && e.id == id;
+      }))
+    Save();
+}
+
+void TabFolderModel::Save() {
+  base::ListValue list;
+  for (const auto& e : entries_) {
+    base::DictValue value;
+    value.Set("id", e.id);
+    value.Set("parent", e.parent);
+    if (e.is_folder()) {
+      value.Set("name", base::UTF16ToUTF8(e.name));
+      value.Set("collapsed", e.collapsed);
+    }
+    list.Append(std::move(value));
+  }
+  prefs_->SetList(kTabFoldersPref, std::move(list));
+}
+
+}  // namespace helium_pins
