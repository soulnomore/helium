+void HeliumPinsService::MoveTabsToFolder(
+    BrowserWindowInterface* browser,
+    const std::vector<tabs::TabHandle>& handles,
+    const std::string& folder,
+    const std::string& before,
+    bool unpin) {
+  if (!prefs_ || !IsSyncedBrowser(browser) || !CanChangePins(browser))
+    return;
+  TabFolderModel folders(*prefs_);
+  if (!folder.empty() && !folders.IsFolder(folder))
+    return;
+  TabStripModel* model = browser->GetTabStripModel();
+  auto* active = model->GetActiveTab();
+  const auto* active_pin =
+      active ? HeliumPinsTabController::From(active) : nullptr;
+  // Leave a folded branch showing its current tab intact. Otherwise reveal
+  // the newly filed tabs at their destination.
+  const bool reveal =
+      !active_pin || !folders.Contains(folder, active_pin->pin_id());
+  std::vector<tabs::TabHandle> members;
+  for (auto handle : handles) {
+    auto* tab = handle.Get();
+    if (!tab || tab->GetBrowserWindowInterface() != browser)
+      continue;
+    if (auto split = tab->GetSplit()) {
+      for (auto* part : model->GetSplitData(*split)->ListTabs()) {
+        members.push_back(part->GetHandle());
+      }
+    } else {
+      members.push_back(handle);
+    }
+  }
+
+  std::vector<std::string> ids;
+  std::set<tabs::TabHandle> visited;
+  for (auto handle : members) {
+    auto* tab = handle.Get();
+    if (!tab || !visited.insert(handle).second)
+      continue;
+    if (tab->IsPinned() == unpin) {
+      model->SetTabPinned(model->GetIndexOfTab(tab), !unpin);
+    }
+    if (unpin)
+      continue;
+    // A tab can have arrived pinned during the drag before the pin service
+    // finished reconciling. AddPin reuses any existing pin identity.
+    AddPin(browser, tab);
+    ids.push_back(HeliumPinsTabController::From(tab)->pin_id());
+  }
+  if (!unpin)
+    TabFolderModel(*prefs_).Move(ids, folder, before, reveal);
 }
 
