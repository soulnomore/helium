+ public:
+  TabFolderButton(TabFolderController& owner, std::string id)
+      : LabelButton(base::BindRepeating(&TabFolderButton::Toggle,
+                                        base::Unretained(this))),
+        owner_(owner),
+        id_(std::move(id)) {
+    SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    SetImageLabelSpacing(7);
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 6)));
+    SetFocusBehavior(FocusBehavior::ALWAYS);
+    set_context_menu_controller(this);
+    editor_ =
+        AddChildView(std::make_unique<FolderNameField>(base::BindRepeating(
+            &TabFolderButton::FinishEdit, weak_factory_.GetWeakPtr(), true)));
+    editor_->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    editor_->SetVisible(false);
+    editor_->GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_HELIUM_FOLDER_NAME));
+    editor_->set_controller(this);
+  }
+  void Update(const TabFolderModel::Entry& entry, bool compact) {
+    compact_ = compact;
+    collapsed_ = entry.collapsed;
+    SetHorizontalAlignment(compact ? gfx::ALIGN_CENTER : gfx::ALIGN_LEFT);
+    SetText(compact ? std::u16string() : entry.name);
+    GetViewAccessibility().SetName(entry.name);
+    SetTooltipText(compact ? entry.name : std::u16string());
+    UpdateIcon();
+    if (collapsed_)
+      GetViewAccessibility().SetIsCollapsed();
+    else
+      GetViewAccessibility().SetIsExpanded();
+  }
+  void Edit() {
+    if (!GetWidget())
+      return;
+    const auto* entry = owner_->model_.Find(id_);
+    if (!entry)
+      return;
+    if (compact_) {
+      owner_->node_->GetController()->GetStateController()->RequestCollapse(
+          false);
+    }
+    editor_->SetText(entry->name);
+    editor_->SetVisible(true);
+    editor_->SetBoundsRect(GetLocalBounds());
+    editor_->RequestFocus();
+    editor_->SelectAll(false);
+  }
+  using DropPosition = TabFolderController::DropPosition;
+  void Mark(std::optional<DropPosition> position) {
+    position_ = position;
+    UpdateIcon();
+    SetBackground(position == DropPosition::kInside
+                      ? views::CreateRoundedRectBackground(
+                            ui::kColorSysStateHoverOnSubtle, 6)
+                      : nullptr);
+    SchedulePaint();
+  }
+
+ private:
+  void UpdateIcon() {
+    const bool open = !collapsed_ || position_ == DropPosition::kInside;
+    SetImageModel(STATE_NORMAL, ui::ImageModel::FromVectorIcon(
+                                    open ? vector_icons::kFolderOpenIcon
+                                         : vector_icons::kFolderFlippableIcon,
+                                    ui::kColorIcon, compact_ ? 22 : 16));
+  }
+  void OnPaintBorder(gfx::Canvas* canvas) override {
+    LabelButton::OnPaintBorder(canvas);
+    if (position_ == DropPosition::kBefore ||
+        position_ == DropPosition::kAfter) {
+      const int y = position_ == DropPosition::kBefore ? 0 : height() - 2;
+      canvas->FillRect(gfx::Rect(0, y, width(), 2),
+                       GetColorProvider()->GetColor(ui::kColorSysPrimary));
+    }
+  }
+  void Toggle() { owner_->model_.Toggle(id_); }
+  void FinishEdit(bool save) {
+    if (!editor_->GetVisible())
+      return;
+    const std::u16string text(editor_->GetText());
+    editor_->SetVisible(false);
+    if (save)
+      owner_->model_.Rename(id_, text);
+  }
+  void Layout(PassKey) override {
+    LayoutSuperclass<views::LabelButton>(this);
+    if (editor_->GetVisible())
+      editor_->SetBoundsRect(GetLocalBounds());
+  }
+  bool HandleKeyEvent(views::Textfield*, const ui::KeyEvent& e) override {
+    if (e.type() != ui::EventType::kKeyPressed ||
+        (e.key_code() != ui::VKEY_RETURN && e.key_code() != ui::VKEY_ESCAPE))
+      return false;
+    FinishEdit(e.key_code() == ui::VKEY_RETURN);
+    RequestFocus();
+    return true;
+  }
+  bool OnKeyPressed(const ui::KeyEvent& e) override {
+    if (e.key_code() == ui::VKEY_F2) {
+      Edit();
+      return true;
+    }
+    if (e.key_code() == ui::VKEY_LEFT || e.key_code() == ui::VKEY_RIGHT) {
+      const auto* entry = owner_->model_.Find(id_);
+      if (entry && entry->collapsed == (e.key_code() == ui::VKEY_RIGHT))
+        Toggle();
+      return true;
+    }
+    return LabelButton::OnKeyPressed(e);
+  }
+  void ShowContextMenuForViewImpl(views::View*,
+                                  const gfx::Point& point,
+                                  ui::mojom::MenuSourceType source) override {
+    owner_->ShowMenu(id_, point, source);
+  }
+  bool OnMousePressed(const ui::MouseEvent& e) override {
+    start_ = e.IsOnlyLeftMouseButton() ? std::make_optional(e.location())
+                                       : std::nullopt;
+    dragging_ = false;
+    return LabelButton::OnMousePressed(e);
+  }
+  bool OnMouseDragged(const ui::MouseEvent& e) override {
+    if (start_ &&
+        (dragging_ || ExceededDragThreshold(e.location() - *start_))) {
+      dragging_ = true;
+      owner_->DragFolder(id_, ConvertPointToScreen(this, e.location()), false);
+      return true;
+    }
+    return LabelButton::OnMouseDragged(e);
+  }
+  void OnMouseReleased(const ui::MouseEvent& e) override {
+    start_.reset();
+    if (std::exchange(dragging_, false)) {
+      SetState(STATE_NORMAL);
+      owner_->DragFolder(id_, ConvertPointToScreen(this, e.location()), true);
+      return;
+    }
+    LabelButton::OnMouseReleased(e);
+  }
+  void OnMouseCaptureLost() override {
+    start_.reset();
+    dragging_ = false;
+    owner_->Highlight({});
+    LabelButton::OnMouseCaptureLost();
+  }
+  const raw_ref<TabFolderController> owner_;
+  const std::string id_;
+  raw_ptr<views::Textfield> editor_;
+  std::optional<gfx::Point> start_;
+  bool dragging_ = false;
+  bool compact_ = false;
+  bool collapsed_ = false;
+  std::optional<DropPosition> position_;
+  base::WeakPtrFactory<TabFolderButton> weak_factory_{this};
+};
