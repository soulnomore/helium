+IN_PROC_BROWSER_TEST_F(TabViewTest,
+                       FolderRetainsNativeTabAcrossCollapseAndUnpack) {
+  auto* tab = tab_strip_model()->GetActiveTab();
+  const auto handle = tab->GetHandle();
+  AppendTab();
+  auto* other = tab_strip_model()->GetActiveTab();
+  ASSERT_NE(other, tab);
+
+  auto* profile = browser()->GetProfile();
+  helium_pins::TabFolderModel folders(*profile->GetPrefs());
+  const auto folder = folders.Create({}, u"Research");
+  auto* pins = PinnedTabServiceFactory::GetForProfile(profile);
+  ASSERT_TRUE(pins);
+  pins->MoveTabsToFolder(browser(), {handle}, folder, {}, false);
+  ASSERT_TRUE(tab->IsPinned());
+  auto* row = GetTabView(tab_strip_model()->GetIndexOfTab(tab));
+  ASSERT_TRUE(row);
+  auto* container = views::AsViewClass<PinnedTabContainerView>(row->parent());
+  ASSERT_TRUE(container);
+  EXPECT_TRUE(container->IsFolderRow(*row));
+  // The service wrote the pin's membership through the same profile pref.
+  helium_pins::TabFolderModel filed(*profile->GetPrefs());
+  filed.Toggle(folder);
+  ASSERT_TRUE(base::test::RunUntil([&] { return !row->GetVisible(); }));
+  EXPECT_EQ(other, tab_strip_model()->GetActiveTab());
+
+  tab_strip_model()->ActivateTab(tab);
+  ASSERT_TRUE(base::test::RunUntil([&] { return row->GetVisible(); }));
+  EXPECT_EQ(tab, row->GetTabInterface());
+  tab_strip_model()->ActivateTab(other);
+  ASSERT_TRUE(base::test::RunUntil([&] { return !row->GetVisible(); }));
+
+  filed.Unpack(folder);
+  ASSERT_TRUE(base::test::RunUntil([&] { return row->GetVisible(); }));
+  EXPECT_FALSE(container->IsFolderRow(*row));
+  EXPECT_EQ(tab, row->GetTabInterface());
+  EXPECT_TRUE(tab->IsPinned());
+}
