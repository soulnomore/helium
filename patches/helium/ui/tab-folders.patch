+bool IsActiveRow(const views::View* row) {
+  if (auto* tab = views::AsViewClass<TabView>(row))
+    return tab->IsActive();
+  auto* split = views::AsViewClass<SplitTabView>(row);
+  return split && split->collection_node() &&
+         std::ranges::any_of(split->collection_node()->GetDirectChildren(),
+                             [](auto* child) {
+                               auto* tab = views::AsViewClass<TabView>(child);
+                               return tab && tab->IsActive();
+                             });
+}
+
+void FileTabs(base::WeakPtr<BrowserWindowInterface> browser,
+              std::vector<tabs::TabHandle> tabs,
+              std::string folder,
+              std::string before,
+              bool unpin) {
+  if (!browser || browser->IsDeleteScheduled())
+    return;
+  if (auto* service =
+          PinnedTabServiceFactory::GetForProfile(browser->GetProfile())) {
+    service->MoveTabsToFolder(browser.get(), tabs, folder, before, unpin);
+  }
+}
