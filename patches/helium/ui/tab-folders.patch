+std::string PinId(const TabView* view) {
+  const auto* tab = view ? view->GetTabInterface() : nullptr;
+  const auto* pin = tab ? helium_pins::HeliumPinsTabController::Get(
+                              tab->GetUnownedUserDataHost())
+                        : nullptr;
+  return pin ? pin->pin_id() : std::string();
+}
