+// Copyright 2026 The Helium Authors
+// Use, redistribution, and modification are permitted under the GPL-3.0
+// license.
+
+#include "chrome/browser/ui/tabs/tab_folder_model.h"
+
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium_pins {
+namespace {
+
+TEST(TabFolderModelTest, RestoresOrderedNestedFoldersAndNativePinIdentities) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(kTabFoldersPref);
+  TabFolderModel folders(prefs);
+  const std::string parent = folders.Create({}, u"Work");
+  const std::string nested = folders.Create(parent, u"Reading");
+  folders.Toggle(nested);
+  folders.Move({"pin-one", "pin-two"}, nested, {}, /*reveal=*/false);
+  EXPECT_TRUE(folders.Find(nested)->collapsed);
+  folders.Move({"pin-two"}, nested, "pin-one");
+  EXPECT_FALSE(folders.Find(nested)->collapsed);
+  folders.Toggle(parent);
+  TabFolderModel restored(prefs);
+  ASSERT_TRUE(restored.Find(parent));
+  EXPECT_TRUE(restored.Find(parent)->collapsed);
+  ASSERT_EQ(4u, restored.entries().size());
+  EXPECT_EQ("pin-two", restored.entries()[2].id);
+  EXPECT_EQ(nested, restored.entries()[2].parent);
+  EXPECT_TRUE(restored.Contains(parent, "pin-one"));
+  restored.Move({parent}, nested);
+  EXPECT_TRUE(restored.Find(parent)->parent.empty());
+  restored.Rename(nested, u"  Archive ");
+  EXPECT_EQ(u"Archive", restored.Find(nested)->name);
+  restored.Unpack(nested);
+  EXPECT_EQ(parent, restored.Find("pin-one")->parent);
+  restored.ForgetPin("pin-one");
+  EXPECT_FALSE(restored.Find("pin-one"));
+  restored.Unpack(parent);
+  EXPECT_TRUE(TabFolderModel(prefs).entries().empty());
+}
+
+TEST(TabFolderModelTest, UnpacksChildrenAtTheOriginalFolderPosition) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(kTabFoldersPref);
+  TabFolderModel folders(prefs);
+  const auto a = folders.Create({}, u"A");
+  const auto b = folders.Create({}, u"B");
+  const auto c = folders.Create({}, u"C");
+  const auto d = folders.Create(b, u"D");
+  folders.Unpack(b);
+  ASSERT_EQ(3u, folders.entries().size());
+  EXPECT_EQ(a, folders.entries()[0].id);
+  EXPECT_EQ(d, folders.entries()[1].id);
+  EXPECT_EQ(c, folders.entries()[2].id);
+}
+
