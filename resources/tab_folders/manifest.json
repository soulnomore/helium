{
  "manifest_version": 3,
  "name": "Tab folders",
  "version": "0.1.0",
  "description": "Keep tabs in nested folders in the Helium sidebar.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "favicon"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "worker.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Tab folders"
  }
}
